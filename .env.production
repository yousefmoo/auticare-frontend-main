# AutiCare Production API Configuration (used by Vercel build)
# No trailing slash, no /api suffix — API paths already include /api
VITE_API_BASE_URL=https://auticare-production.up.railway.app
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME=AutiCare
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_REAL_TIME=false
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true
